# ~/.gitconfig.role-rules - Git role rules
# Generated by sync.sh from src/.gitconfig.roles. Do not edit; edits are overwritten.
# Remote-owner rules are last so they take precedence over directory fallbacks.

# Personal GitHub owner routing
[url "git@github.com-personal:pat-home/"]
	insteadOf = git@github.com:pat-home/
	insteadOf = https://github.com/pat-home/

# Work GitHub owner routing
[url "git@github.com-work:pat-corp/"]
	insteadOf = git@github.com:pat-corp/
	insteadOf = https://github.com/pat-corp/
[url "git@github.com-work:CorpOrg/"]
	insteadOf = git@github.com:CorpOrg/
	insteadOf = https://github.com/CorpOrg/

# Default identity fallback
[include]
	path = ~/.gitconfig.work

# Work directory fallbacks
[includeIf "gitdir/i:~/work/"]
	path = ~/.gitconfig.work
[includeIf "gitdir/i:~/clients/acme"]
	path = ~/.gitconfig.work

# Personal GitHub identity rules
[includeIf "hasconfig:remote.*.url:git@github.com:pat-home/**"]
	path = ~/.gitconfig.personal
[includeIf "hasconfig:remote.*.url:https://github.com/pat-home/**"]
	path = ~/.gitconfig.personal
[includeIf "hasconfig:remote.*.url:git@github.com-personal:pat-home/**"]
	path = ~/.gitconfig.personal
# Work GitHub identity rules
[includeIf "hasconfig:remote.*.url:git@github.com:pat-corp/**"]
	path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:https://github.com/pat-corp/**"]
	path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:git@github.com-work:pat-corp/**"]
	path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:git@github.com:CorpOrg/**"]
	path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:https://github.com/CorpOrg/**"]
	path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:git@github.com-work:CorpOrg/**"]
	path = ~/.gitconfig.work
# Work Bitbucket identity rules
[includeIf "hasconfig:remote.*.url:git@bitbucket.org:corp-team/**"]
	path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:https://bitbucket.org/corp-team/**"]
	path = ~/.gitconfig.work
