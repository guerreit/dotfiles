# SSH Configuration for Multiple Keys
# This file will be copied to ~/.ssh/config during setup

# Personal GitHub account
Host github.com-personal github.com-guerreit
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_github_personal
  IdentitiesOnly yes

# Work GitHub account
Host github.com-work github.com-garrettj-slalom
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_github_work
  IdentitiesOnly yes

# Unqualified GitHub URLs are deterministic; owner rewrites select work as needed.
Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_github_personal
  IdentitiesOnly yes

# Default settings for all hosts
Host *
  AddKeysToAgent yes
  UseKeychain yes
  IdentitiesOnly yes
