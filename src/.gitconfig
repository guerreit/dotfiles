[alias]
  # Add untracked, remove deleted, and show status
  adda = !git add -A && git status

  # Show verbose output about tags, branches or remotes
  tags = tag -l
  branches = branch -a
  remotes = remote -v

  # Switch to a branch, creating it if necessary
  go = "!f() { git checkout -b \"$1\" 2> /dev/null || git checkout \"$1\"; }; f"

  # get rid of all my branches that are merged
  prunegone = "!git fetch -p && for branch in `git branch -vv | grep ': gone]' | awk '{print $1}'`; do git branch -D $branch; done"

  reset = "git reset HEAD --hard"

  up = !"git remote update -p; git merge --ff-only @{u}"

# color opts: normal, black, red, green, yellow, blue, magenta, cyan, or white
[color]
  ui = always

[core]
  # Use custom `.gitignore` and `.gitattributes`
  excludesfile = ~/.gitignore
  attributesfile = ~/.gitattributes

[user]
  useConfigOnly = true

# correct typos
[help]
  autocorrect = 1

# Include summaries of merged commits in newly created merge commit messages
[merge]
  log = true


# push easily. http://stackoverflow.com/a/23918418/89484
[push]
  default = current
  followTags = true

[fetch]
  prune = true

[diff]
  compactionHeuristic = true

[pull]
  rebase = false

# =============================================================================
# Role-based Configuration (Automatic Git Identity Switching)
# =============================================================================
# WARNING: This section is automatically generated by sync.sh
# Do not edit manually - changes will be overwritten
# To customize your Git identities and directory patterns:
#   1. Edit src/.gitconfig.roles in your dotfiles repo
#   2. Run: ./scripts/sync.sh
#
# How it works:
# - Repository owners select both the SSH host alias and Git identity
# - Directory patterns provide a fallback before a remote is configured
# - Remote-owner rules are last so they take precedence over fallbacks
# =============================================================================

# Personal GitHub owner routing
[url "git@github.com-personal:guerreit/"]
	insteadOf = git@github.com:guerreit/
	insteadOf = https://github.com/guerreit/

# Work GitHub owner routing
[url "git@github.com-work:garrettj-slalom/"]
	insteadOf = git@github.com:garrettj-slalom/
	insteadOf = https://github.com/garrettj-slalom/
[url "git@github.com-work:Slalom/"]
	insteadOf = git@github.com:Slalom/
	insteadOf = https://github.com/Slalom/
[url "git@github.com-work:abs-wavesight/"]
	insteadOf = git@github.com:abs-wavesight/
	insteadOf = https://github.com/abs-wavesight/
[url "git@github.com-work:ASPCA-Membership/"]
	insteadOf = git@github.com:ASPCA-Membership/
	insteadOf = https://github.com/ASPCA-Membership/

# Default identity fallback
[include]
	path = ~/.gitconfig.personal

# Work directory fallbacks
[includeIf "gitdir:~/work/"]
	path = ~/.gitconfig.work
[includeIf "gitdir:~/clients/"]
	path = ~/.gitconfig.work
[includeIf "gitdir:~/code/work/"]
	path = ~/.gitconfig.work

# Personal GitHub identity rules
[includeIf "hasconfig:remote.*.url:git@github.com:guerreit/**"]
	path = ~/.gitconfig.personal
[includeIf "hasconfig:remote.*.url:git@github.com-personal:guerreit/**"]
	path = ~/.gitconfig.personal
[includeIf "hasconfig:remote.*.url:https://github.com/guerreit/**"]
	path = ~/.gitconfig.personal
# Work GitHub identity rules
[includeIf "hasconfig:remote.*.url:git@github.com:garrettj-slalom/**"]
	path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:git@github.com-work:garrettj-slalom/**"]
	path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:git@github.com-garrettj-slalom:garrettj-slalom/**"]
	path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:https://github.com/garrettj-slalom/**"]
	path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:git@github.com:Slalom/**"]
	path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:git@github.com-work:Slalom/**"]
	path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:git@github.com-garrettj-slalom:Slalom/**"]
	path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:https://github.com/Slalom/**"]
	path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:git@github.com:abs-wavesight/**"]
	path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:git@github.com-work:abs-wavesight/**"]
	path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:git@github.com-garrettj-slalom:abs-wavesight/**"]
	path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:https://github.com/abs-wavesight/**"]
	path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:git@github.com:ASPCA-Membership/**"]
	path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:git@github.com-work:ASPCA-Membership/**"]
	path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:git@github.com-garrettj-slalom:ASPCA-Membership/**"]
	path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:https://github.com/ASPCA-Membership/**"]
	path = ~/.gitconfig.work
# Work Bitbucket identity rules
[includeIf "hasconfig:remote.*.url:git@bitbucket.org:slalom-consulting/**"]
	path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:https://bitbucket.org/slalom-consulting/**"]
	path = ~/.gitconfig.work
