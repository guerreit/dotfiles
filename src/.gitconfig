[alias]
  # Add untracked, remove deleted, and show status
  adda = !git add -A && git status

  # Show verbose output about tags, branches or remotes
  tags = tag -l
  branches = branch -a
  remotes = remote -v

  # Switch to a branch, creating it if necessary
  go = "!f() { git checkout -b \"$1\" 2> /dev/null || git checkout \"$1\"; }; f"

  # delete local branches whose upstream was deleted
  prunegone = "!git fetch -p && git for-each-ref --format '%(refname:short) %(upstream:track)' refs/heads | while IFS=' ' read -r branch track; do [ \"$track\" = '[gone]' ] && git branch -D \"$branch\"; done"

  nuke = reset --hard HEAD

  up = !"git remote update -p; git merge --ff-only @{u}"

# color opts: normal, black, red, green, yellow, blue, magenta, cyan, or white
[color]
  ui = auto

[core]
  # Use custom `.gitignore` and `.gitattributes`
  excludesfile = ~/.gitignore_global
  attributesfile = ~/.gitattributes

[user]
  useConfigOnly = true

# correct typos
[help]
  autocorrect = 1

# Include summaries of merged commits in newly created merge commit messages
[merge]
  log = true


# push easily. http://stackoverflow.com/a/23918418/89484
[push]
  default = current
  followTags = true

[fetch]
  prune = true

[diff]
  indentHeuristic = true

[commit]
  template = ~/.stCommitMsg

[pull]
  rebase = false

# Git role rules (url rewrites, default identity, includeIf) are generated by
# sync.sh from src/.gitconfig.roles. Keep this include last so they apply
# after everything above.
[include]
  path = ~/.gitconfig.role-rules
