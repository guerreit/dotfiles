# .gitconfig.roles - Role-based Git Configuration
# ====================================================
# This file configures automatic Git identity switching based on repository location.
# Edit this file to customize your Git identities and directory patterns.
#
# How it works:
# - Repositories under "work patterns" use your work identity
# - All other repositories use your personal identity
# - Git automatically detects which identity to use based on directory path
#
# After editing this file, run: ./scripts/sync.sh

# Personal Identity
# -----------------
# Used for repositories that don't match any work patterns
GIT_PERSONAL_NAME="Garrett Jones"
GIT_PERSONAL_EMAIL="garrettjones@me.com"

# Work Identity
# -------------
# Used for repositories under work directory patterns
GIT_WORK_NAME="Garrett Jones"
GIT_WORK_EMAIL="garrettj@slalom.com"

# Remote Owners
# -------------
# Repository owners determine both the SSH key and commit identity, regardless
# of where a repository is cloned. Add new organizations here once.
GIT_PERSONAL_GITHUB_OWNERS=(
  "guerreit"
)

GIT_WORK_GITHUB_OWNERS=(
  "garrettj-slalom"
  "Slalom"
  "abs-wavesight"
  "ASPCA-Membership"
)

GIT_WORK_BITBUCKET_OWNERS=(
  "slalom-consulting"
)

# Work Directory Patterns
# ------------------------
# These are fallback rules for new repositories that do not have a remote yet.
# Remote-owner rules take precedence once a remote is configured.
# Patterns support wildcards:
#   - Use ** for recursive matching (e.g., ~/work/** matches all repos under ~/work/)
#   - Use * for single-level matching
#   - Paths must be absolute or start with ~/
#
# Examples:
#   ~/work/**           - All repos under ~/work/
#   ~/clients/**        - All repos under ~/clients/
#   ~/code/company/**   - All repos under ~/code/company/
#
GIT_WORK_PATTERNS=(
  "~/work/**"
  "~/clients/**"
  "~/code/work/**"
)

# Default Role
# ------------
# Which identity to use when neither a remote owner nor directory pattern matches.
# Recommended: "personal"
GIT_DEFAULT_ROLE="personal"
